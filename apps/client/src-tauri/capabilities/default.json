{
  "identifier": "default",
  "description": "Local main reader window, including application IIIF commands",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "core:window:allow-close"
  ]
}
