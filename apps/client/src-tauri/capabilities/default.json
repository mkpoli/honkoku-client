{
  "identifier": "default",
  "description": "Local main reader window, including application IIIF commands",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "core:window:allow-close",
    "allow-session-sign-in",
    "allow-session-import",
    "allow-session-current",
    "allow-session-clear",
    "allow-home-timeline",
    "allow-home-ranking",
    "allow-home-ranking-self",
    "allow-home-announcements",
    "allow-home-daily-progress",
    "allow-me",
    "allow-unread-notification-count",
    "allow-get-user",
    "allow-page-lock",
    "allow-page-draft",
    "allow-page-draft-notes",
    "allow-history-open",
    "allow-history-recent",
    "allow-history-clear",
    "allow-page-save",
    "allow-page-discard",
    "allow-page-lock-state",
    "allow-list-projects",
    "allow-get-project",
    "allow-list-collections",
    "allow-list-entry-summaries",
    "allow-collection-progress",
    "allow-entry-progress",
    "allow-get-collection",
    "allow-get-entry",
    "allow-list-pages",
    "allow-iiif-prepare-entry",
    "allow-iiif-local-url",
    "allow-ocr-status",
    "allow-editing-pages",
    "allow-project-page-activity",
    "allow-region-cached",
    "allow-region-refresh",
    "allow-ocr-diagnostics",
    "allow-ocr-doctor",
    "allow-ocr-repair-models",
    "allow-ocr-setup",
    "allow-ocr-run-page",
    "allow-ocr-cancel",
    "allow-ocr-result",
    "allow-ocr-publish-page",
    "allow-search-status",
    "allow-search-choose-dump",
    "allow-search-build",
    "allow-search-query",
    "allow-search-sync",
    "allow-glyph-attestations",
    "allow-clips-list",
    "allow-clip-create",
    "allow-clip-delete",
    "allow-glyph-image-url",
    "allow-page-history",
    "allow-entry-bibliography",
    "allow-save-transcription",
    "allow-save-full-image"
  ]
}
